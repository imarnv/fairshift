# Set these as Cloud Run secrets / env vars, or export them in your shell for a local run. Never commit real values.
# Each key is 32 random bytes, base64-encoded:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENV=production
DATA_KEY=
PASSPORT_SIGNING_KEY=
JWT_SECRET=

# Voice: the Gemini key (from Secret Manager on Cloud Run). Or leave it empty and set the project to use Vertex AI.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_API_KEY=

# Only when the web app is hosted on another domain (e.g. Vercel):
ALLOWED_ORIGINS=
